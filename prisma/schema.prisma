generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROBLEM_SETTER
  CONTESTANT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(CONTESTANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}